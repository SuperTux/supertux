msgstr "Buzun Altında"

#: data/levels/world1/welcome_antarctica.stl:3
msgid "Welcome to Antarctica"
msgstr "Antartika'ya hoş geldiniz"

#: data/levels/world1/welcome_antarctica.stl:117
msgid ""
"-Eggs\n"
"!images/powerups/egg/egg-shade.png\n"
"#The egg makes Tux grow larger. Tux can then smash wooden blocks with his head."
msgstr "-Yumurtalar\n!images/powerups/egg/egg-shade.png\n#Yumurta, Tux'un büyümesini sağlar. Tux daha sonra tahta blokları kafasıyla parçalayabilir."

#: data/levels/world1/welcome_antarctica.stl:126
msgid ""
"-Fire Flower\n"
"!images/powerups/fireflower/fire_flower-0.png\n"
"#The fire flower gives Tux the ability to shoot fireballs."
msgstr "-Ateş çiçeği\n !images/powerups/fireflower/fire_flower-0.png\n#Ateş çiçeği Tux'un ateş topu atabilmesini sağlar. "

#: data/levels/world1/welcome_antarctica.stl:135
msgid ""
"-Tux Doll\n"
"!images/powerups/1up/1up.png\n"
"#Tux Dolls are a rare collectible which are needed to unlock the Bonus Islands!\n"
"\n"
"#Collect all of them to unlock fun, additional levels!"
msgstr "-Tux Bebeği\n!images/powerups/1up/1up.png\n#Tux Bebekleri, Bonus Adaları’nın kilidini açmak için gereken nadir koleksiyon nesneleridir!\n\n#Eğlenceli ek bölümlerin kilidini açmak için hepsini topla!"

#: data/levels/world1/yeti_boss.stl:3
msgid "No More Mr. Ice Guy"
msgstr "Bay Buz Adam’ın Sonu"

#: data/levels/world1/yeti_cutscene.stl:3
msgid "An Unsuspected Follower"
msgstr "Beklenmedik Bir Takipçi"

#: data/levels/world1/yetiwin_cutscene.stl:3
msgid "Off to the Glacier Isles"
msgstr "Buzul Adaları’na Doğru"
